{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finn-web",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "assets": {
    "directory": "./build/web",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "finn.8020solutions.org", "custom_domain": true }
  ]
}
